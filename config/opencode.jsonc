{
  "$schema": "https://opencode.ai/config.json",
  "username": "FrancescoCastaldi",

  // ==========================================
  // DEFAULT AGENT & MODELLI
  // ==========================================
  "default_agent": "orchestrator",
  "model": "opencode/deepseek-v4-flash-free",  // Modello predefinito
  // "small_model": "opencode-go/*",      // modello per tasks semplici

  // ==========================================
  // SKILLS Ã¢â‚¬â€ percorsi per SKILL.md
  // ==========================================
  "skills": {
    "paths": ["~/.config/opencode/skills"
    ]
  },

  // ==========================================
  // REFERENCES Ã¢â‚¬â€ documentazione esterna
  // ==========================================
  "references": {
    "react": {
      "repository": "facebook/react",
      "branch": "main",
      "description": "Use for React core implementation details and source code"
    },
    "nextjs": {
      "repository": "vercel/next.js",
      "branch": "canary",
      "description": "Use for Next.js implementation details and API reference"
    },
    "typescript": {
      "repository": "microsoft/TypeScript",
      "branch": "main",
      "description": "Use for TypeScript compiler and type system reference"
    }
  },

  // ==========================================
  // AGENTS Ã¢â‚¬â€ definizione agenti
  // ==========================================
  "agent": {
    // Configurazioni speciali
    "title": {
      "model": "opencode/deepseek-v4-flash-free"
    },
    "summary": {
      "model": "opencode/deepseek-v4-flash-free"
    },
    // --- Agent PRINCIPALI (built-in overrides) ---
    "orchestrator": {
      "description": "Orchestrator che coordina agenti specializzati in parallelo per workflow complessi",
      "mode": "primary",
      "color": "#4ade80",
      "prompt": "{file:~/.config/opencode/agent/orchestrator.md}",
      "permission": {
        "read": "allow",
        "edit": "allow",
        "write": "allow",
        "bash": "allow",
        "glob": "allow",
        "grep": "allow",
        "webfetch": "allow",
        "websearch": "allow",
        "task": "allow",
        "todowrite": "allow"
      }
    },
    "general": {
      "description": "Agente general-purpose per implementazione, refactoring e bug fix",
      "mode": "primary",
      "color": "#60a5fa",
      "prompt": "{file:~/.config/opencode/agent/general.md}",
      "permission": {
        "read": "allow", "edit": "allow", "write": "allow", "bash": "allow",
        "glob": "allow", "grep": "allow", "webfetch": "allow", "websearch": "allow",
        "task": "allow", "todowrite": "allow"
      }
    },
    "explore": {
      "description": "Agente rapido per esplorazione e analisi del codice",
      "mode": "primary",
      "color": "#f59e0b",
      "prompt": "{file:~/.config/opencode/agent/explore.md}",
      "permission": {
        "read": "allow", "edit": "deny", "write": "deny",
        "bash": "allow", "glob": "allow", "grep": "allow",
        "webfetch": "allow", "websearch": "allow", "task": "allow"
      }
    },
    "brainstormer": {
      "description": "Agente creativo per ideazione, naming, UX e problemi aperti",
      "mode": "primary",
      "color": "#a855f7",
      "temperature": 0.8,
      "prompt": "{file:~/.config/opencode/agent/brainstormer.md}",
      "permission": {
        "read": "allow", "edit": "deny", "write": "deny", "bash": "deny",
        "glob": "allow", "grep": "allow", "webfetch": "allow", "websearch": "allow",
        "task": "allow"
      }
    },
    "build": {
      "description": "Agente di implementazione diretta con accesso completo agli strumenti",
      "mode": "primary",
      "color": "#34d399",
      "prompt": "{file:~/.config/opencode/agent/build.md}",
      "permission": {
        "read": "allow", "edit": "allow", "write": "allow", "bash": "allow",
        "glob": "allow", "grep": "allow", "webfetch": "allow", "websearch": "allow",
        "task": "allow", "todowrite": "allow"
      }
    },

    // --- Agent SPECIALIZZATI (subagent) ---
    "reviewer": {
      "description": "Revisore del codice Ã¢â‚¬â€ analisi qualitÃƒÂ , sicurezza e best practices",
      "mode": "subagent",
      "color": "#f43f5e",
      "prompt": "{file:~/.config/opencode/agent/reviewer.md}",
      "permission": {
        "read": "allow", "edit": "deny", "write": "deny",
        "bash": "allow", "glob": "allow", "grep": "allow",
        "webfetch": "allow", "websearch": "allow", "task": "allow"
      }
    },
    "debugger": {
      "description": "Agente specializzato in debugging Ã¢â‚¬â€ trova e risolve bug",
      "mode": "subagent",
      "color": "#ef4444",
      "prompt": "{file:~/.config/opencode/agent/debugger.md}",
      "permission": {
        "read": "allow", "edit": "allow", "write": "allow", "bash": "allow",
        "glob": "allow", "grep": "allow", "webfetch": "allow", "websearch": "allow",
        "task": "allow"
      }
    },
    "optimizer": {
      "description": "Agente di ottimizzazione performance Ã¢â‚¬â€ codice + infrastruttura",
      "mode": "subagent",
      "color": "#10b981",
      "prompt": "{file:~/.config/opencode/agent/optimizer.md}",
      "permission": {
        "read": "allow", "edit": "allow", "write": "allow", "bash": "allow",
        "glob": "allow", "grep": "allow", "webfetch": "allow", "websearch": "allow",
        "task": "allow"
      }
    },
    "tester": {
      "description": "Agente di test Ã¢â‚¬â€ scrive, esegue e mantiene test",
      "mode": "subagent",
      "color": "#8b5cf6",
      "prompt": "{file:~/.config/opencode/agent/tester.md}",
      "permission": {
        "read": "allow", "edit": "allow", "write": "allow", "bash": "allow",
        "glob": "allow", "grep": "allow", "webfetch": "allow", "websearch": "allow",
        "task": "allow"
      }
    },
    "docker": {
      "description": "Agente DevOps/Docker Ã¢â‚¬â€ container, compose, CI/CD, deploy",
      "mode": "subagent",
      "color": "#0ea5e9",
      "prompt": "{file:~/.config/opencode/agent/docker.md}",
      "permission": {
        "read": "allow", "edit": "allow", "write": "allow", "bash": "allow",
        "glob": "allow", "grep": "allow", "webfetch": "allow", "websearch": "allow",
        "task": "allow"
      }
    },
    "database": {
      "description": "Agente database Ã¢â‚¬â€ SQL, SQLite, PostgreSQL, ottimizzazione query",
      "mode": "subagent",
      "color": "#14b8a6",
      "prompt": "{file:~/.config/opencode/agent/database.md}",
      "permission": {
        "read": "allow", "edit": "allow", "write": "allow", "bash": "allow",
        "glob": "allow", "grep": "allow", "webfetch": "allow", "websearch": "allow",
        "task": "allow"
      }
    },
    "refactor": {
      "description": "Agente di refactoring Ã¢â‚¬â€ ristruttura codice senza cambiarne il comportamento",
      "mode": "subagent",
      "color": "#f97316",
      "prompt": "{file:~/.config/opencode/agent/refactor.md}",
      "permission": {
        "read": "allow", "edit": "allow", "write": "allow", "bash": "allow",
        "glob": "allow", "grep": "allow", "webfetch": "allow", "websearch": "allow",
        "task": "allow"
      }
    },
    "scriptwriter": {
      "description": "Agente per scripting Ã¢â‚¬â€ PowerShell, bash, Python automation",
      "mode": "subagent",
      "color": "#eab308",
      "prompt": "{file:~/.config/opencode/agent/scriptwriter.md}",
      "permission": {
        "read": "allow", "edit": "allow", "write": "allow", "bash": "allow",
        "glob": "allow", "grep": "allow", "webfetch": "allow", "websearch": "allow",
        "task": "allow"
      }
    }
  },

  // ==========================================
  // MCP SERVERS Ã¢â‚¬â€ 15+ server per ogni evenienza
  // ==========================================
  "mcp": {
    // --- Server giÃƒÂ  esistenti ---
    "playwright": {
      "type": "local",
      "command": ["node", "C:\\Users\\fracas\\.config\\opencode\\node_modules\\@playwright\\mcp\\cli.js"],
      "enabled": true,
      "timeout": 60000
    },
    "github": {
      "type": "local",
      "command": ["node", "C:\\Users\\fracas\\.config\\opencode\\node_modules\\@modelcontextprotocol\\server-github\\dist\\index.js"],
      "enabled": true,
      "timeout": 60000,
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "{file:~/.config/opencode/.github-token}"
      }
    },
    "puppeteer": {
      "type": "local",
      "command": ["node", "C:\\Users\\fracas\\.config\\opencode\\node_modules\\@modelcontextprotocol\\server-puppeteer\\dist\\index.js"],
      "enabled": false,
      "description": "Disabilitato - playwright giÃ  copre browser automation"
    },
    "opencode": {
      "type": "local",
      "command": ["node", "C:\\Users\\fracas\\.config\\opencode\\node_modules\\opencode-mcp\\dist\\index.js"],
      "enabled": true,
      "timeout": 60000
    },

    // --- Server NUOVI: Web & Search ---
    "fetch": {
      "type": "local",
      "command": ["node", "C:\\Users\\fracas\\.config\\opencode\\node_modules\\mcp-fetch-server\\dist\\index.js"],
      "enabled": true,
      "timeout": 60000
    },

    // --- Server NUOVI: AI & Reasoning ---
    "sequential-thinking": {
      "type": "local",
      "command": ["node", "C:\\Users\\fracas\\.config\\opencode\\node_modules\\@modelcontextprotocol\\server-sequential-thinking\\dist\\index.js"],
      "enabled": true,
      "timeout": 60000
    },
    "memory": {
      "type": "local",
      "command": ["node", "C:\\Users\\fracas\\.config\\opencode\\node_modules\\@modelcontextprotocol\\server-memory\\dist\\index.js"],
      "enabled": true,
      "timeout": 60000
    },
    "mcp-ops": {
      "type": "local",
      "command": ["npx", "-y", "mcp-ops"],
      "enabled": false
    },

    // --- Server PRO: contesto & ricerca ---
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true
    },
    "gh_grep": {
      "type": "remote",
      "url": "https://mcp.grep.app",
      "enabled": true
    }
  },

  // ==========================================
  // LSP SERVERS Ã¢â‚¬â€ Language support
  // ==========================================
  "lsp": {
    "typescript": {
      "command": ["typescript-language-server", "--stdio"],
      "extensions": [".ts", ".tsx", ".mts", ".cts"]
    },
    "javascript": {
      "command": ["typescript-language-server", "--stdio"],
      "extensions": [".js", ".jsx", ".mjs", ".cjs"]
    },
    "html": {
      "command": ["vscode-html-language-server", "--stdio"],
      "extensions": [".html", ".htm"]
    },
    "css": {
      "command": ["vscode-css-language-server", "--stdio"],
      "extensions": [".css", ".scss", ".less", ".sass"]
    },
    "json": {
      "command": ["vscode-json-language-server", "--stdio"],
      "extensions": [".json", ".jsonc", ".json5"]
    },
    "markdown": {
      "command": ["vscode-markdown-language-server", "--stdio"],
      "extensions": [".md", ".mdx"]
    },
    "latex": {
      "command": ["texlab"],
      "extensions": [".tex", ".sty", ".cls", ".bib"]
    },
    "python": {
      "command": ["pyright-langserver", "--stdio"],
      "extensions": [".py"],
      "enabled": false
    },
    "docker": {
      "command": ["dockerfile-language-server-nodejs", "--stdio"],
      "extensions": ["Dockerfile", ".dockerfile"],
      "enabled": false
    },
    "yaml": {
      "command": ["yaml-language-server", "--stdio"],
      "extensions": [".yaml", ".yml"],
      "enabled": false
    }
  },

  // ==========================================
  // PLUGINS
  // ==========================================
  "plugin": [
    "opencode-mem",
    "opencode-snippets",
    "opencode-supermemory",
    "opencode-background-agents",
    "opencode-worktree",
    "opencode-notify",
    "oh-my-opencode-slim"
  ],

  // ==========================================
  // PERMESSI GLOBALI
  // ==========================================
  "permission": {
    "read": "allow",
    "edit": "allow",
    "glob": "allow",
    "grep": "allow",
    "bash": "allow",
    "task": "allow",
    "todowrite": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "skill": "allow",
    "question": "allow",
    "external_directory": "allow"
  },

  // ==========================================
  // COMPORTAMENTO
  // ==========================================
  "compaction": {
    "auto": true,
    "tail_turns": 15
  }
}



