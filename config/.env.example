# ============================================
# OpenCode PRO - Environment Variables
# ============================================
# Copy this to .env and fill in your values.
# The installer script will prompt you for these.
# ============================================

# --- REQUIRED: GitHub Personal Access Token ---
# Needed for: GitHub MCP server (PRs, issues, code search)
# Create one at: https://github.com/settings/tokens
# Scopes needed: repo, read:user, read:org
GITHUB_TOKEN=ghp_your_token_here

# --- OPTIONAL: OpenCode Provider API Keys ---
# You can configure these interactively via `opencode providers add`
# Or set them here for automated setup:

# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
# GOOGLE_API_KEY=...

# --- OPTIONAL: opencode-mem Auto-Capture ---
# Only needed if you want AI-powered auto-capture of memories
# MEMORY_API_KEY=sk-...
# MEMORY_MODEL=gpt-4o-mini
# MEMORY_API_URL=https://api.openai.com/v1

# --- OPTIONAL: OpenCode Username ---
# OPENCODE_USERNAME=yourname
