# ============================================
# OpenCode PRO Setup - Environment Variables
# ============================================
# Copy this to .env and fill in your values.
# The installer script will prompt you for these.
# ============================================

# --- OpenCode Zen API Key ---
# Provider: opencode
# Set via: opencode providers add opencode
# Or set the OPENCODE_API_KEY environment variable.
OPENCODE_API_KEY=your_opencode_zen_key_here

# --- OpenCode Go API Key ---
# Provider: opencode-go
# Or set the OPENCODE_GO_API_KEY environment variable.
OPENCODE_GO_API_KEY=your_opencode_go_key_here

# --- GitHub Personal Access Token ---
# Needed for: GitHub MCP server (code search, etc.)
# Create one at: https://github.com/settings/tokens
# Scopes needed: repo, read:user
GITHUB_TOKEN=ghp_your_token_here

# --- OpenCode Username ---
# OPENCODE_USERNAME=yourname

# --- Optional: Provider API Keys ---
# Configure via: opencode providers add <provider>
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
